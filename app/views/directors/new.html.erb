<h1>New director</h1>
<% @director.errors.full_messages.each do |message| %>
  <p style="color: red;"><%= message %></p>
<% end %>
<%= form_with(model: @director) do |form|%>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :dob %>
    <%= form.date_select :dob, start_year: 1900, end_year: Date.today.year %>
  </div>

  <div>
    <%= form.label :bio %>
    <%= form.text_area :bio, rows: 3 %>
  </div>

  <%= form.submit "Create Director" %>
  <% end %>
